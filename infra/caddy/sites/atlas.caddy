atlas.shadowinc.co {
        import atlas_security_headers
        import atlas_access_log
        encode zstd gzip

        route {
                handle /_atlas/ingress-health {
                        respond "ok" 200
                }
                # Forward authorization is an internal proxy operation only.
                handle /_atlas/maintenance/* {
                        respond "Not Found" 404
                }
                @atlas_maintenance {
                        file {
                                root /etc/atlas-maintenance
                                try_files /enabled /control-pending
                        }
                }
                @admin_console path /maintenance/admin.html /maintenance/admin.js /maintenance/admin.css
                handle @admin_console {
                        header Cache-Control "no-store"
                        header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
                        root * /srv
                        file_server
                }
                handle /maintenance/* {
                        root * /srv
                        file_server
                }
                @atlas_api_metadata path /api/docs /api/docs/* /api/openapi.json /api/redoc /api/redoc/*
                handle @atlas_api_metadata {
                        respond "Not Found" 404
                }
                # These exact credential entry points still enforce API admission.
                @atlas_auth_entry {
                        method POST
                        path /api/v1/auth/login /api/v1/auth/refresh /api/v1/auth/logout /api/v1/auth/browser/login /api/v1/auth/browser/refresh /api/v1/auth/browser/logout
                }
                handle @atlas_auth_entry {
                        reverse_proxy atlas-api:8000
                }
                # Drain only a viewer's signed, scoped cleanup capability.
                # API validation still checks owner, session, target and lease.
                @atlas_live_release {
                        method DELETE
                        path_regexp maintenance_release ^/api/v1/sports/live/sessions/[A-Za-z0-9_-]{1,256}/release-capability$
                }
                handle @atlas_live_release {
                        reverse_proxy atlas-api:8000
                }
                handle @atlas_maintenance {
                        route {
                                import atlas_required_admin_auth
                                handle /api/* {
                                        reverse_proxy atlas-api:8000
                                }
                                handle {
                                        reverse_proxy atlas-portal:3000
                                }
                        }
                }
                handle {
                        route {
                                # Consult the authority even if the local marker is absent.
                                import atlas_maintenance_auth
                                handle /api/* {
                                        reverse_proxy atlas-api:8000
                                }
                                handle {
                                        reverse_proxy atlas-portal:3000
                                }
                        }
                }
        }
        handle_errors {
                import atlas_maintenance_page
        }
}

# Dedicated Atlas Theater media transport.
playback.shadowinc.co {
        encode zstd gzip

        # Temporary origin-side playback diagnostic. The entire
        # request object is discarded before log encoding, not
        # merely redacted when operators read the log. Do not
        # import the general Atlas access-log snippet here.
        log {
                output file /var/log/caddy/atlas-playback-diagnostic.log {
                        roll_size 1MiB
                        roll_keep 2
                        roll_keep_for 24h
                }

                format filter {
                        request delete
                        resp_headers delete
                        user_id delete
                        err_id delete
                        err_trace delete
                        wrap json
                }
        }

        # Fixed diagnostic labels only. Caddy evaluates path matchers
        # without persisting the path, query, headers, or identifiers.
        # The privacy-filtered logger continues deleting the entire
        # request object before writing the diagnostic.
        @playback_diagnostic_playlist path_regexp ^/videos/[^/]+/.*\.m3u8$
        @playback_diagnostic_segment path_regexp ^/videos/[^/]+/.*\.(ts|m4s|mp4)$
        @playback_diagnostic_bootstrap path /_atlas/playback/bootstrap

        log_append @playback_diagnostic_playlist playback_request_type HLS_PLAYLIST
        log_append @playback_diagnostic_segment playback_request_type HLS_SEGMENT
        log_append @playback_diagnostic_bootstrap playback_request_type PLAYBACK_BOOTSTRAP

        header Access-Control-Allow-Origin "https://atlas.shadowinc.co"
        header Access-Control-Allow-Credentials "true"
        header Vary "Origin"

        @playback_bootstrap_options {
                method OPTIONS
                path /_atlas/playback/bootstrap
        }

        @playback_held {
                file {
                        root /etc/atlas-maintenance
                        try_files /enabled /control-pending
                }
        }

        route {
                # Browser headers cannot turn off or fabricate a local hold.
                request_header -X-Atlas-Maintenance-Required
                request_header @playback_held X-Atlas-Maintenance-Required "1"
                handle @playback_bootstrap_options {
                        header Access-Control-Allow-Headers "Authorization, Content-Type"
                        header Access-Control-Allow-Methods "POST, OPTIONS"
                        respond "" 204
                }

                handle /_atlas/playback/bootstrap {
                        reverse_proxy atlas-api:8000
                }

                @playback_media path /videos/*

                handle @playback_media {
                        forward_auth atlas-api:8000 {
                                uri /_atlas/playback/authorize
                                copy_headers X-Atlas-Jellyfin-Authorization
                        }

                        reverse_proxy jellyfin:8096 {
                                header_up Authorization {http.request.header.X-Atlas-Jellyfin-Authorization}
                                header_up -X-Atlas-Jellyfin-Authorization

                                # Atlas owns browser CORS on the dedicated playback
                                # origin. Do not expose Jellyfin's wildcard CORS
                                # response alongside Atlas's credentialed origin.
                                header_down -Access-Control-Allow-Origin
                                header_down -Access-Control-Allow-Credentials
                        }
                }

                handle {
                        respond "Not Found" 404
                }
        }

}

# Jellyfin is the playback/transcoding backend behind Atlas Theater.
# End users enter playback through /portal/theater; this hostname exists as
# the HTTPS transport destination for Jellyfin web/native clients.
jellyfin.shadowinc.co {
        import atlas_access_log

        encode zstd gzip

        @jellyfin_held {
                file {
                        root /etc/atlas-maintenance
                        try_files /enabled /control-pending
                }
        }
        route {
                handle @jellyfin_held {
                        header Cache-Control "no-store"
                        header Retry-After "300"
                        respond "Atlas is under maintenance." 503
                }
                handle {
                        route {
                                import atlas_closed_media_origin_auth
                                reverse_proxy jellyfin:8096
                        }
                }
        }
        handle_errors {
                header Cache-Control "no-store"
                header Retry-After "300"
                respond "Atlas media is unavailable." 503
        }
}
