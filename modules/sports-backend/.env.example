# Project Atlas Sports Backend
#
# Runtime secrets belong in modules/sports-backend/.env.
# Never commit the real .env file.

SPORTS_BACKEND_TIMEZONE=America/New_York

# Persistent state
DISPATCHARR_DATA_DIR=/mnt/storage/configs/dispatcharr
TEAMARR_DATA_DIR=/mnt/storage/configs/teamarr

# Internal service addressing.
# These services are intentionally not exposed through Atlas public ingress.
DISPATCHARR_INTERNAL_URL=http://atlas-dispatcharr:9191
TEAMARR_INTERNAL_URL=http://atlas-teamarr:9195

